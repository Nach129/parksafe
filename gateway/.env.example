# Plantilla de variables del Gateway: copiar a .env y ajustar secretos/puertos segun el entorno.
# Mantiene centralizadas las direcciones de microservicios para demostrar transparencia de ubicacion.
PORT=8080

# Servicios base usados para registro de usuarios/vehiculos e inicio de sesion.
REGISTER_SERVICE_URL=http://localhost:3001
LOGIN_SERVICE_URL=http://localhost:3002

# Servicios replicados de estacionamiento; el Gateway decide el activo con heartbeat.
PRIMARY_NODE_URL=http://localhost:3003
BACKUP_NODE_URL=http://localhost:3004

# Cambiar en un entorno real; firma y valida tokens JWT.
JWT_SECRET=CAMBIAR_CLAVE_SECRETA

# Tiempo maximo que el Gateway espera por una respuesta aguas abajo.
REQUEST_TIMEOUT_MS=5000
