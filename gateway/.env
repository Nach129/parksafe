# COMENTARIOS PARKSAFE
# Configuracion del API Gateway: este proceso es el punto de entrada unico del frontend.
# Las URLs siguientes indican a que microservicio se reenvia cada tipo de peticion.
PORT=8080

# Microservicios base: registro y login viven separados del flujo de estacionamiento.
REGISTER_SERVICE_URL=http://localhost:3001
LOGIN_SERVICE_URL=http://localhost:3002

# Nodos de negocio replicados: el Gateway elige entre primario y respaldo segun heartbeat/failover.
PRIMARY_NODE_URL=http://localhost:3003
BACKUP_NODE_URL=http://localhost:3004

# Secreto compartido para validar JWT recibidos desde el login-service.
JWT_SECRET=parksafe_clave_secreta_super_segura

# Timeout maximo de una peticion proxy antes de considerarla fallida.
REQUEST_TIMEOUT_MS=5000

# Heartbeat: frecuencia, tiempo de espera y numero de fallos antes de promover/redirigir.
HEARTBEAT_INTERVAL_MS=3000
HEARTBEAT_TIMEOUT_MS=1500
HEARTBEAT_FAILURE_LIMIT=3
