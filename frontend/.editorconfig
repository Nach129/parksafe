# Configuracion de editor: ayuda a que todos los archivos del frontend mantengan formato consistente.
# No ejecuta logica de Angular; solo define reglas de espacios, saltos de linea y comillas.
# Editor configuration, see https://editorconfig.org
root = true

# Reglas generales para todos los archivos editables del frontend.
[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Regla especifica de TypeScript: el proyecto usa comillas simples.
[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

# Markdown permite lineas largas para documentacion sin romper el formato.
[*.md]
max_line_length = off
trim_trailing_whitespace = false
