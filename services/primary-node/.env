# Variables del nodo primario: este servicio procesa reservas mientras su rol sea PRIMARY.
PORT=3003

# Identidad logica del nodo, usada en health checks, respuestas y defensa de failover.
NODE_NAME=PRIMARY
NODE_ROLE=PRIMARY

# Conexion MySQL propia del primario; aqui se bloquean filas y se confirman reservas.
DB_HOST=localhost
DB_PORT=3307
DB_USER=parksafe
DB_PASSWORD=parksafe123
DB_NAME=parksafe_primary

# URL del respaldo: destino de las operaciones replicadas despues del commit local.
BACKUP_NODE_URL=http://localhost:3004

# Tiempo maximo para intentar replicar una operacion al respaldo.
REPLICATION_TIMEOUT_MS=3000
