# Plantilla del nodo primario: copiar a .env y ajustar credenciales si cambia el entorno.
PORT=3003

# Rol inicial del proceso en el modelo primario-respaldo.
NODE_NAME=PRIMARY
NODE_ROLE=PRIMARY

# Base de datos del primario, separada de auth y del respaldo.
DB_HOST=localhost
DB_PORT=3307
DB_USER=ticketsafe
DB_PASSWORD=parksafe123
DB_NAME=ticketsafe_primary

# Direccion del nodo espejo al que se envia la replicacion pasiva.
BACKUP_NODE_URL=http://localhost:3004
REPLICATION_TIMEOUT_MS=3000
