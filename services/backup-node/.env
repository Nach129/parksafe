# Variables del nodo respaldo: mantiene copia sincronizada y puede asumir trafico si cae el primario.
PORT=3004

# Identidad y rol inicial; BACKUP/STANDBY evita procesar reservas directas hasta una promocion.
NODE_NAME=BACKUP
NODE_ROLE=BACKUP

# Conexion MySQL propia del respaldo; almacena el estado replicado del primario.
DB_HOST=localhost
DB_PORT=3308
DB_USER=parksafe
DB_PASSWORD=parksafe123
DB_NAME=parksafe_backup

# Referencia al primario para sincronizacion y comparaciones de estado.
PRIMARY_NODE_URL=http://localhost:3003
# Parametros de replicacion saliente/reintento en caso de operaciones pendientes.
REPLICATION_TIMEOUT_MS=3000
REPLICATION_RETRY_INTERVAL_MS=5000
