# Plantilla del login-service: copiar a .env y cambiar el secreto JWT antes de entregar.
PORT=3002

# Conexion a la base de usuarios donde se leen correos, nombres de usuario y hashes.
DB_HOST=localhost
DB_PORT=3306
DB_USER=ticketsafe
DB_PASSWORD=parksafe123
DB_NAME=ticketsafe_auth

# Secreto de firma y expiracion del JWT devuelto al frontend.
JWT_SECRET=CAMBIAR_CLAVE_SECRETA
JWT_EXPIRES_IN=2h
